  "components": {
    "schemas": {
      "Signal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kol": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              },
              "attribution": {
                "type": "string"
              }
            }
          },
          "action": {
            "enum": ["BUY", "SELL"]
          },
          "token": {
            "type": "string"
          },
          "tokenMint": {
            "type": "string"
          },
          "quoteMint": {
            "type": "string"
          },
          "conviction": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
