              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "dataMode": {
                      "type": "string"
                    },
                    "payments": {
                      "type": "string"
                    },
                    "ingestion": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "stale": {
                          "type": "boolean"
                        },
                        "lastSuccessAt": {
                          "type": ["integer", "null"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
