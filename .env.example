# Node.js 22.12+. Copy to .env for local development.
PORT=3000
HOST=127.0.0.1
SENTRIC_DEV_MODE=true
# Never enable development bypass with NODE_ENV=production.
# Legacy SENTRY_DEV_MODE remains supported for migration.

# Live ingestion (optional); no key means an honest empty/unconfigured feed.
HELIUS_API_KEY=
# Optional Enhanced WebSocket endpoint from your Helius plan.
HELIUS_WS_URL=
JUPITER_API_KEY=
BACKFILL_ON_START=false
AUTO_DISCOVERY=false

# Wallet-management authentication. Generate your own high-entropy token.
ADMIN_API_KEY=
# Optional durable directory. Mount a persistent volume in production.
DATA_DIR=
SIGNAL_TTL_SECONDS=300
MAX_SIGNALS=10000

# x402 v2. Pick a facilitator that explicitly supports your Solana network.
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=
TREASURY_WALLET=
# Devnet; for mainnet use solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SIGNAL_PRICE_USDC=0.001
CONSENSUS_PRICE_USDC=0.005

# Set to the exact trusted proxy hop count only behind a known proxy.
TRUST_PROXY_HOPS=0
SOCIAL_PROVIDER=none
X_BEARER_TOKEN=
SOCIALDATA_API_KEY=
SOCIAL_FAST_POLL_MS=15000
SOCIAL_MID_POLL_MS=60000
SOCIAL_SLOW_POLL_MS=300000
